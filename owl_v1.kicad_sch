	(text "Formula used to calculate capacitance for crystals:\n\nC_{L} = (C_{L1} × C_{L2}) / (C_{L1} + C_{L2}) + C_{stray}"
		(exclude_from_sim no)
		(at 98.806 47.244 0)
		(effects
