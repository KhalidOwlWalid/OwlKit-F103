	(text "RCC Crystals"
		(exclude_from_sim no)
		(at 23.876 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "43f7d46a-dd8b-4625-9d79-39e98e78050d")
	)
	(text "The number of 100nF capacitor reflects to the number of available VDD pins.\nAs per the application notes:\nIn addition, each power supply pair must be decoupled with filtering\nceramic capacitors C (100 nF) and a chemical capacitor C of about 10 μF\nconnected in parallel on the STM32F10xxx device."
		(exclude_from_sim no)
		(at 88.9 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "74bd1fdd-97bf-478e-aa1e-4f3d5e4bca84")
	)
	(text "Decoupling Capacitor"
		(exclude_from_sim no)
		(at 27.686 90.932 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "802220e3-5b3b-4228-881c-4b83ebcbbac8")
	)
	(text "Note: 0R placed here as per the application notes.\nRule of thumb is 5-6x of the ESR of the crystals."
		(exclude_from_sim no)
