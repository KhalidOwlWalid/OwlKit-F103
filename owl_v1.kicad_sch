	(text "Regulates power from USB-C 5V to 3.3V via XC6206P302 power regulator. \nFerrite beads are placed to reduce noises at high frequencies.\nInspiration taken from Phil's lab STM32 design\n(https://github.com/pms67/STM32F1-Breakout-Board)"
		(exclude_from_sim no)
		(at 95.25 119.126 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1d3e53b1-3db8-43a8-8be8-ce41b1704e15")
	)
	(text "Decoupling Capacitor"
		(exclude_from_sim no)
		(at 32.766 16.002 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "5e8e9435-c707-47b7-a596-27bdb9054d99")
	)
	(text "The number of 100nF capacitor reflects to the number of available VDD pins.\nAs per the application notes:\nIn addition, each power supply pair must be decoupled with filtering\nceramic capacitors C (100 nF) and a chemical capacitor C of about 10 μF\nconnected in parallel on the STM32F10xxx device."
		(exclude_from_sim no)
		(at 93.98 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "976b5f7a-d203-4ad4-ab75-dd1758734074")
	)
	(text "USB Power Regulator"
		(exclude_from_sim no)
		(at 34.036 64.516 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "d72d74e9-5e25-46d4-b517-4b9858892cbe")
	)
