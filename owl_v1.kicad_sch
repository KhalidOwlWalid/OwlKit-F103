	(text "The number of 100nF capacitor reflects to the number of available VDD pins.\nAs per the application notes:\nIn addition, each power supply pair must be decoupled with filtering\nceramic capacitors C (100 nF) and a chemical capacitor C of about 10 μF\nconnected in parallel on the STM32F10xxx device."
		(exclude_from_sim no)
		(at 88.9 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "74bd1fdd-97bf-478e-aa1e-4f3d5e4bca84")
	)
