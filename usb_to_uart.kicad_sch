	)
	(text "It is worth noting that the FT230X functions as a full speed USB 2.0\ndevice (12Mb/s) as opposed to High Speed device (480Mb/s). Hence, it is\nnot as important to match USB 2.0 impedance for the differential pairs.\nAlthough, it does not hurt to do so.\n\nSource: FT230X Datasheet, p. 29, Sec. 8.1, see USB Version description"
		(exclude_from_sim no)
		(at 59.436 92.456 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f9ee1db5-db00-47a5-b543-992e1efec44c")
	)
